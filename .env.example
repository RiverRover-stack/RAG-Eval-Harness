# GitHub GraphQL API (for pulling Discussions Q&A)
GITHUB_TOKEN=
GITHUB_REPO_OWNER=fastapi
GITHUB_REPO_NAME=fastapi

# Chroma vector store
CHROMA_PERSIST_DIR=./data/processed/chroma

# fastembed's ONNX model cache
FASTEMBED_CACHE_DIR=./data/processed/fastembed

# Ollama (local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=fdm-llama
OLLAMA_EMBED_MODEL=nomic-embed-text

# Eval
EVAL_SET_PATH=./data/eval_sets/fastapi_discussions_eval.jsonl

# RAGAS judge: "ollama" (local), "groq" (hosted, free tier), or "gemini" (hosted, free tier)
RAGAS_JUDGE=ollama
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# RAGAS execution tuning
RAGAS_MAX_WORKERS=1
RAGAS_TIMEOUT=600

# Trim the eval set for a quick validation pass (0 = use the full set)
EVAL_SAMPLE_LIMIT=0

# Docs (for building chunk source URLs, path + anchor)
DOCS_BASE_URL=https://fastapi.tiangolo.com
